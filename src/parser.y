std::string nodenameResultToString(Nodename::NodenameResult result)
{
  std::stringstream stream;

  std::string types[] = {
    "SIMPLE_NODE",
    "NODE_PLACEHOLDER",
    "SUBTREE_RANGE_PLACEHOLDER",
    "END_MARKER"
  };

  std::string placeholders[] = {
    "NONE",
    "CUT",
    "COPY"
  };

  std::string defOrRefs[] = {
    "NONE",
    "DEFINITION",
    "REFERENCE"
  };

  stream << "{";
  stream << "type:\"" << types[(int)result.type] << "\",";
  stream << "placeholder:\"" << placeholders[(int)result.placeholder] << "\",";
  stream << "placeholderNumber:" << result.placeholderNumber << ",";
  stream << "undetermined:" << (result.undetermined ? "true" : "false") << ",";
  stream << "freeOfContext:" << (result.freeOfContext ? "true" : "false") << ",";
  stream << "defOrRef:\"" << defOrRefs[(int)result.defOrRef] << "\",";
  stream << "regex:\"" << result.regex << "\"";
  stream << "}";

  return stream.str();
}

int main(int argc, char *argv[]) 
{
  if (argc > 1)
  {
    yyin = fopen(argv[1], "r");

    if (!yyin) {
      perror("fopen");
      return 1;
    }
  }
  else
    yyin = stdin;

  yyparse();

  if (yyin != stdin)
    fclose(yyin);

  return 0;
}

int yyerror(const char *s)
{
  fprintf(stderr, "ERROR: %s, in line %d, column %d, near token %s\n", s, yylineno, yycolumn, yytext);
  exit(-1);
}