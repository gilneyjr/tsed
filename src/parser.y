      ss << "{";
      ss << "restrictions:" << *$1 << ",";
      ss << "terminal_or:\"" << *$2 << "\",";
      ss << "restrictions_and:" << *$3;
      ss << "}";

      $$ = new string(ss.str());
    }
  | restrictions_and
    {
      stringstream ss;

      ss << "{";
      ss << "restrictions_and:" << *$1;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

restrictions_and:
  restrictions_and terminal_and restrictions_not
    {
      stringstream ss;

      ss << "{";
      ss << "restrictions_and:" << *$1 << ",";
      ss << "terminal_and:\"" << *$2 << "\",";
      ss << "restrictions_not:" << *$3;
      ss << "}";

      $$ = new string(ss.str());
    }
  |	restrictions_and restrictions_not	/* same as AND */
    {
      stringstream ss;

      ss << "{";
      ss << "restrictions_and:" << *$1 << ",";
      ss << "restrictions_not:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  | restrictions_not
    {
      stringstream ss;

      ss << "{";
      ss << "restrictions_not:" << *$1;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

restrictions_not:
  terminal_not restrictions_not
    {
      stringstream ss;

      ss << "{";
      ss << "terminal_not:\"" << *$1 << "\",";
      ss << "restrictions_not:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  |	lpar restrictions rpar
    {
      stringstream ss;

      ss << "{";
      ss << "lpar:\"" << *$1 << "\",";
      ss << "restrictions:" << *$2 << ",";
      ss << "rpar:\"" << *$3 << "\"";
      ss << "}";

      $$ = new string(ss.str());
    }
  | restriction /* break precedence, [] on tgrep*/
    {
      stringstream ss;

      ss << "{";
      ss << "restriction:" << *$1;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

restriction:
  op search_second
    {
      stringstream ss;

      ss << "{";
      ss << "op:\"" << *$1 << "\",";
      ss << "search_second:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

search_second:
  lpar search_expression rpar
    {
      stringstream ss;

      ss << "{";
      ss << "lpar:\"" << *$1 << "\",";
      ss << "search_expression:" << *$2 << ",";
      ss << "rpar:\"" << *$3 << "\"";
      ss << "}";

      $$ = new string(ss.str());
    }
  | search_primary
    {
      stringstream ss;

      ss << "{";
      ss << "search_primary:" << *$1;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;


search_primary:
  node_specifier
    { // TODO: See if this rule can be removed, because its useless
      auto result = *$1;
      stringstream ss;
      ss << "{";
      ss << "node_specifier:" << nodenameResultToString(result);
      ss << "}";
      $$ = new string(ss.str());
    }
  ;

