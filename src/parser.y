      // Nodespec node_spec = machine.execute();

      // if (node_spec.type == NODE_EXCEPTION)
      //   yyerror(node_spec.errors.c_str());

      // ss << "<node_name="<< node_spec.regex.c_str() << ">";

      /* for more comprehensive debug */

