// #include "lex.yy.c" // TODO: try to understant why this is being included here

  int main(int argc, char *argv[]) 
  {
    if (argc > 1)
    {
      yyin = fopen(argv[1], "r");

      if (!yyin) {
        perror("fopen");
        return 1;
      }
    }
    else
      yyin = stdin;

    yyparse();

    if (yyin != stdin)
      fclose(yyin);

    return 0;
  }

int yyerror(const char *s)
{
  fprintf(stderr, "ERROR: %s, in line %d, column %d, near token %s\n", s, nline, nchar, yytext);
  exit(-1);
}