  #include <sstream> // std::stringstream, std::istringstream

  #include "nodename_machine.hpp"

  using namespace std;
  using namespace Nodename;

  extern FILE *yyin;   // Declaration of the yyin variable generated by lex that points to the input file
  extern char *yytext; // Declaration of the yytext variable generated by lex
  extern int yylineno; // Declaration of yylineno variable generated by lex
  extern int yycolumn; // Declaration of yycolumn variable defined in yacc file

  extern int yylex(void); // Declaration of the yylex function generated by lex
  int yyerror(const char *s); // Declaration of the yyerror function defined below

  std::string nodenameResultToString(Nodename::NodenameResult); // Auxiliary function defined below
%}

%code requires {
  #include <string>
  #include "nodename_result.hpp"
}

/* Definition of union used to define terminal and non-terminal types */
/* TODO: Verify if num is really necessary */
%union {
  std::string *lexem;
  Nodename::NodenameResult *nodenameResult;
};

%token <lexem> op end_marker lpar nodename rpar terminal_and terminal_not terminal_or turnsto

%type <lexem> start
%type <lexem> search_expression
%type <lexem> opt_restrictions
%type <lexem> restrictions
%type <lexem> restrictions_and
%type <lexem> restrictions_not
%type <lexem> restriction
%type <lexem> search_second
%type <lexem> search_primary
%type <nodenameResult> node_specifier

%%

start:
  search_expression // turnsto replacement_expression
    {
      stringstream ss;

      ss << "{";
      ss << "search_expression:" << *$1;
      ss << "}";

      string s = ss.str();
      cout << s << endl;
      $$ = new string(s);
    }
  ;

search_expression:
  search_primary opt_restrictions
    {
      stringstream ss;

      ss << "{";
      ss << "search_primary:" << *$1 << ",";
      ss << "opt_restrictions:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

opt_restrictions:
