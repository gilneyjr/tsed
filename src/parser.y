  extern int yylex(void); // Declaration of the yylex function generated by lex
  int yyerror(const char *s); // Declaration of the yyerror function defined below
  extern char *yytext; // Declaration of the yytext variable generated by lex
  
  // TODO: try to understand what this is for
  int nchar, nline, nword;
%}

%code requires {
  #include <string>
}

/* Definition of union used to define terminal and non-terminal types */
%union {
  std::string *output;
  int tk;
};

%token <output> doms domted end_marker eq fstchild fstchildpar homon imdoms imdomted imlsibl imprec imrsibl imsucc lastchild lastchildpar lmanc lmdesc lpar lsibl ndoms ndomted nfstchild nfstchildpar nimdoms nimdomted nimlsibl nimprec nimrsibl nimsucc nlastchild nlastchildpar nlmanc nlmdesc nlsibl nnthchild nnthchild_end nnthparent nnthparent_end nodename nonlychild nonlychildpar nprec nrmanc nrmdesc nrsibl nsiblproper nsingascpath nsingdescpat nsucc nthchild nthchild_end nthparent nthparent_end onlychild onlychildpar prec rmanc rmdesc rpar rsibl siblproper singascpath singdescpat succ terminal_and terminal_not terminal_or turnsto


/* try to understand why these tokens are not in the lex definition */ 
nEQ
nHOMON
node_range_filler

%type <output> start
%type <output> search_expression
%type <output> opt_restrictions
%type <output> restrictions
%type <output> restrictions_and
%type <output> restrictions_not
%type <output> restriction
%type <output> search_second
%type <output> search_primary
%type <output> node_specifier

%%

start:
  search_expression //   turnsto   replacement_expression
    {
      stringstream ss;

      ss << "{";
      ss << "search_expression:" << *$1;
      ss << "}";

      string s = ss.str();
      cout << s << endl;
      $$ = new string(s);
    }
  ;

search_expression:
  search_primary opt_restrictions
    {
      stringstream ss;

      ss << "{";
      ss << "search_primary:" << *$1 << ",";
      ss << "opt_restrictions:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

opt_restrictions:
  restrictions
    {
      stringstream ss;

      ss << "{";
      ss << "restrictions:" << *$1;
      ss << "}";

      $$ = new string(ss.str());
    }
  |
    {
      $$ = new string();
    }
  ;

restrictions:
  restrictions terminal_or restrictions_and
    {
      stringstream ss;

      ss << "{";
      ss << "restrictions:" << *$1 << ",";
      ss << "terminal_or:\"" << *$2 << "\",";
      ss << "restrictions_and:" << *$3;
      ss << "}";

      $$ = new string(ss.str());
    }
  | restrictions_and
    {
      stringstream ss;

      ss << "{";
      ss << "restrictions_and:" << *$1;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

restrictions_and:
  restrictions_and terminal_and restrictions_not
    {
      stringstream ss;

      ss << "{";
      ss << "restrictions_and:" << *$1 << ",";
      ss << "terminal_and:\"" << *$2 << "\",";
      ss << "restrictions_not:" << *$3;
      ss << "}";

      $$ = new string(ss.str());
    }
  |	restrictions_and restrictions_not		/* same as AND */
    {
      stringstream ss;

      ss << "{";
      ss << "restrictions_and:" << *$1 << ",";
      ss << "restrictions_not:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  | restrictions_not
    {
      stringstream ss;

      ss << "{";
      ss << "restrictions_not:" << *$1;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

restrictions_not:
  terminal_not restrictions_not
    {
      stringstream ss;

      ss << "{";
      ss << "terminal_not:\"" << *$1 << "\",";
      ss << "restrictions_not:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  |	lpar restrictions rpar
    {
      stringstream ss;

      ss << "{";
      ss << "lpar:\"" << *$1 << "\",";
      ss << "restrictions:" << *$2 << ",";
      ss << "rpar:\"" << *$3 << "\"";
      ss << "}";

      $$ = new string(ss.str());
    }
  | restriction  /* break precedence, [] on tgrep*/
    {
      stringstream ss;

      ss << "{";
      ss << "restriction:" << *$1;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

restriction:
  imdoms search_second
    {
      stringstream ss;

      ss << "{";
      ss << "imdoms:\"" << *$1 << "\",";
      ss << "search_second:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  |	doms search_second
    {
      stringstream ss;

      ss << "{";
      ss << "doms:\"" << *$1 << "\",";
      ss << "search_second:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  |	imdomted search_second
    {
      stringstream ss;

      ss << "{";
      ss << "imdomted:\"" << *$1 << "\",";
      ss << "search_second:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  | domted search_second
    {
      stringstream ss;

      ss << "{";
      ss << "domted:\"" << *$1 << "\",";
      ss << "search_second:" << *$2;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

search_second:
  lpar search_expression rpar
    {
      stringstream ss;

      ss << "{";
      ss << "lpar:\"" << *$1 << "\",";
      ss << "search_expression:" << *$2 << ",";
      ss << "rpar:\"" << *$3 << "\"";
      ss << "}";

      $$ = new string(ss.str());
    }
  | search_primary
    {
      stringstream ss;

      ss << "{";
      ss << "search_primary:" << *$1;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

search_primary:
  node_specifier
    {
      stringstream ss;

      ss << "{";
      ss << "node_specifier:" << *$1;
      ss << "}";

      $$ = new string(ss.str());
    }
  ;

node_specifier:
  nodename
    {
      stringstream ss;

      ss << "{";
      ss << "nodename:\"" << *$1 << "\"";
      ss << "}";

      $$ = new string(ss.str());

      // stringstream ss;
